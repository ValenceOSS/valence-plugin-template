{
  "name": "valence-plugin-template",
  "private": true,
  "description": "A starting point for a Valence plugin.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest run",
