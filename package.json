    "format": "prettier --write ."
  },
  "dependencies": {
    "@valence/plugin-sdk": "git+https://github.com/ValenceOSS/Valence.git#ef025efe20efca24f7cd52d2d6416fb4df13e1fe&path:/packages/plugin-sdk",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
